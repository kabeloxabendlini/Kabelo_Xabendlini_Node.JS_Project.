<!DOCTYPE html>
<html lang="en">

<%- include('layouts/header'); -%>

<body>

  <%- include('layouts/navbar'); -%>

  <!-- Page Header — uses blog post image as background if available -->
  <header class="masthead" style="background-image: url('<%= blogpost.image ? blogpost.image : "/img/post-bg.jpg" %>')">
    <div class="overlay"></div>
    <div class="container">
      <div class="row">
        <div class="col-lg-8 col-md-10 mx-auto">
          <div class="post-heading">
            <h1><%= blogpost.title %></h1>
            <span class="subheading">
              <%= blogpost.body.replace(/<[^>]*>/g, '').substring(0, 120) %> ...
            </span>
            <span class="meta">
              Posted by <a href="#">
                <%= blogpost.userid ? blogpost.userid.username : 'Unknown' %>
              </a>
              on <%= blogpost.datePosted ? blogpost.datePosted.toDateString() : 'Unknown date' %>
            </span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Post Content -->
<article>
  <div class="container">
    <div class="row">
      <div class="col-lg-8 col-md-10 mx-auto">

        <!-- Always show astronaut image below header -->
        <div class="post-image-wrapper mb-4">
          <img src="/img/post-bg.jpg" class="img-fluid w-100 rounded shadow" alt="Post Image" style="max-height: 500px; object-fit: cover;">
        </div>

        <!-- Display uploaded image below astronaut image if it exists -->
        <% if(blogpost.image) { %>
          <div class="post-image-wrapper mb-4">
            <img src="<%= blogpost.image %>" class="img-fluid w-100 rounded shadow" alt="Post Image" style="max-height: 500px; object-fit: cover;">
          </div>
        <% } %>

        <!-- Render Summernote HTML content -->
        <div class="blog-post-body">
          <%- blogpost.body %>
        </div>

        <hr>

        <!-- Back to Home button -->
        <div class="text-center mt-4 mb-4">
          <a href="/" class="btn btn-primary">← Back to Home</a>
        </div>

      </div>
    </div>
  </div>
</article>

  <hr>

  <%- include('layouts/footer'); -%>
  <%- include('layouts/scripts'); -%>

</body>

</html>
