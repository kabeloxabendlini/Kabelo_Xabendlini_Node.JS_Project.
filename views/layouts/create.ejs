<!DOCTYPE html>
<html lang="en">

<%- include('layouts/header'); -%>

<body>

  <%- include('layouts/navbar'); -%>

  <!-- Page Header -->
  <header class="masthead" style="background-image: url('/img/contact-bg.jpg')">
    <div class="overlay"></div>
    <div class="container">
      <div class="row">
        <div class="col-lg-8 col-md-10 mx-auto">
          <div class="page-heading">
            <h1>Create New Post</h1>
            <span class="subheading">Share your thoughts with the world</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <div class="container">
    <div class="row">
      <div class="col-lg-8 col-md-10 mx-auto">

        <!-- Flash Error Messages -->
        <% if (flashMessages && flashMessages.error && flashMessages.error.length > 0) { %>
          <div class="alert alert-danger mt-4">
            <%= flashMessages.error[0] %>
          </div>
        <% } %>

        <!-- Flash Success Messages -->
        <% if (flashMessages && flashMessages.success && flashMessages.success.length > 0) { %>
          <div class="alert alert-success mt-4">
            <%= flashMessages.success[0] %>
          </div>
        <% } %>

        <form action="/posts/store" method="POST" enctype="multipart/form-data" class="mt-4">

          <!-- Title -->
          <div class="form-group mb-4">
            <label for="title"><strong>Title</strong></label>
            <input
              type="text"
              name="title"
              id="title"
              class="form-control"
              placeholder="Enter post title"
              required>
          </div>

          <!-- Body -->
          <div class="form-group mb-4">
            <label for="body"><strong>Content</strong></label>
            <textarea
              id="summernote"
              name="body"
              class="form-control"
              rows="10"></textarea>
          </div>

          <!-- Image Upload -->
          <div class="form-group mb-4">
            <label for="image"><strong>Upload Image</strong></label>
            <input
              type="file"
              name="image"
              id="image"
              class="form-control"
              accept="image/*">
          </div>

          <br>

          <!-- Buttons -->
          <button type="submit" class="btn btn-primary px-4">Publish Post</button>
          <a href="/" class="btn btn-link">Cancel</a>

        </form>

      </div>
    </div>
  </div>

  <hr>

  <%- include('layouts/footer'); -%>
  <%- include('layouts/scripts'); -%>

  <!-- Summernote -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.20/summernote-bs4.min.css" rel="stylesheet">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.20/summernote-bs4.min.js"></script>

  <script>
    $(document).ready(function() {
      $('#summernote').summernote({
        height: 300,
        placeholder: 'Write your post content here...',
      });
    });
  </script>

</body>

</html>